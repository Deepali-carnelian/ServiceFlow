#
PORT=3000
AUTO_PORT_FALLBACK=true

# Optional Gemini integration. Keep secrets only in your local .env file.
# The app works without this key using deterministic JavaScript fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=auto
AI_TIMEOUT_MS=20000

# Automated intake
AUTO_CREATE_LEADS=true
AUTOMATION_CLIENT_POLL_MS=15000
SAFE_ACK_TEXT=Thanks for contacting our service team. We've received your request and added it to the service queue. If this is an emergency involving product loss, please call the office.

# Gmail / generic mailbox over IMAP + SMTP. No Google Cloud project required.
# For Gmail: enable 2-Step Verification and create an App Password.
EMAIL_USER=
EMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
EMAIL_ONLY_UNSEEN=true
EMAIL_MARK_READ=false
EMAIL_POLL_SECONDS=60
EMAIL_AUTO_ACKNOWLEDGE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Optional webhook protection. Leave blank for local demo use.
WEBSITE_WEBHOOK_SECRET=
TWILIO_WEBHOOK_SECRET=
AUTO_ACKNOWLEDGE_SMS=true

# Optional public URL when exposing webhook endpoints through a deployment/tunnel.
PUBLIC_BASE_URL=
