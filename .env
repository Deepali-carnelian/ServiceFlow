# ServiceFlow Focus — JavaScript/Node.js only
PORT=3000
AUTO_PORT_FALLBACK=true

# Gemini is optional and server-side only. Leave blank for deterministic fallback extraction.
GEMINI_API_KEY="AQ.Ab8RN6IPEI1SX56FxAfw0kFqpBSwrS0jA1et9gXJylE-87-HaA"
GEMINI_MODEL=auto
AI_TIMEOUT_MS=20000

# Automatic inbound capture
AUTO_CREATE_LEADS=true
AUTOMATION_CLIENT_POLL_MS=15000
SAFE_ACK_TEXT=Thanks for contacting ServiceFlow Refrigeration. We've received your request and added it to our service queue. If this is an emergency involving product loss, please call our office.

# Gmail / generic mailbox over IMAP + SMTP. No Google Cloud project required.
# For Gmail use an App Password, never your normal account password.
EMAIL_USER=
EMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
EMAIL_ONLY_UNSEEN=true
EMAIL_MARK_READ=false
EMAIL_POLL_SECONDS=60
EMAIL_AUTO_ACKNOWLEDGE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Website form webhook
WEBSITE_WEBHOOK_SECRET=

# Twilio-compatible SMS webhook
TWILIO_WEBHOOK_SECRET=
AUTO_ACKNOWLEDGE_SMS=true

PUBLIC_BASE_URL=
